# Frontend (Vite) env vars. Copy to .env.local for local dev.
# Anon / publishable keys are safe to ship to the browser; the schema is
# protected by RLS. Never put SERVICE_ROLE_KEY here.

VITE_SUPABASE_URL=https://rhkjukmeulobhpywwsbn.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_IofrZdnTul9ciN-ppB7HXw_JEWtPGPk
VITE_ADMIN_EMAILS=nick@alexanderind.com
VITE_AGOGE_APPLY_URL=https://theagoge.com/apply

# Dev-only login. When set, /login renders a form that bypasses Klaviyo,
# generates a magic link directly, and signs you in. UNSET this in production
# before launch. Value MUST match the WEBHOOK_SECRET set on the Edge Function.
VITE_DEV_LOGIN_SECRET=

# Edge Function secrets (set in the Supabase dashboard, NOT here):
#   SUPABASE_URL                  auto-injected by Supabase
#   SUPABASE_SERVICE_ROLE_KEY     auto-injected by Supabase
#   SITE_URL=https://course.crushyourlimitingbeliefs.com
#   WEBHOOK_SECRET=<random string Klaviyo will send as x-webhook-secret>
#   KLAVIYO_PRIVATE_API_KEY=<Klaviyo Private API key, used to PATCH profiles>
